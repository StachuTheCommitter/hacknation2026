# Skopiuj do .env i uzupełnij (make env robi to automatycznie z losowymi sekretami).
ASI_MASTER_KEY=
ASI_WORKER_TOKEN=
ASI_BOOTSTRAP_ADMIN_EMAIL=admin@asi.local
ASI_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=asi
ASI_PORT=8080
ASI_BASE_URL=http://localhost:8080

# Demo / laboratorium: konta admin@lab, editor@lab, modifier@lab, viewer@lab (hasło: demo-password-<rola>)
ASI_SEED_DEMO_USERS=false
ASI_SEED_DEMO_LAB=false
ASI_DEMO_MODE=false

# DefectDojo (opcjonalnie – można też ustawić w UI: Administracja → DefectDojo)
ASI_DD_URL=
ASI_DD_TOKEN=
